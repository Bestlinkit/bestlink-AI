# Bestlink Digital AI - Backend Environment Template
# Duplicate this to .env for development

PORT=5000
NODE_ENV=production

# Your OpenRouter API Key
OPENROUTER_API_KEY=your_key_here

# The URL where this backend is hosted (e.g. https://bestlink-backend.onrender.com)
PRODUCTION_URL=http://localhost:5000

# The URL where the frontend is hosted (for CORS)
FRONTEND_URL=https://bestlink-digital-ai.web.app
